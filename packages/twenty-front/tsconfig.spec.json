{
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": false,
    "types": ["jest", "node"]
  },
  "include": [
    "**/__mocks__/**/*",
    "jest.config.ts",
    "setupTests.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "tsup.config.ts",
    "twenty-ui.index.tsx",
    "vite.config.ts"
  ]
}
